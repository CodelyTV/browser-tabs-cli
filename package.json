{
  "name": "browser-tabs-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Open and organize tabs in the browser window you already use",
  "type": "module",
  "bin": {
    "browser-tabs-cli": "dist/main.js"
  },
  "files": [
    "dist",
    "schemas",
    "examples",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodelyTV/browser-tabs-cli.git"
  },
  "license": "UNLICENSED",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "pnpm build && node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --import tsx --test tests/*.test.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check",
    "smoke:vivaldi": "node scripts/smoke-vivaldi.mjs",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix ."
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "oxfmt": "0.70.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "ws": "^8.0.0"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c"
}
